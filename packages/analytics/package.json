{
  "name": "@aui/analytics",
  "version": "0.0.1",
  "description": "Analytics, experimentation, significance reporting, and guardrail auto-pause for AUI Engine",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "dev": "tsup src/index.ts --format esm --watch",
    "test": "vitest run",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@aui/schema": "workspace:*"
  },
  "devDependencies": {
    "rimraf": "^6.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
