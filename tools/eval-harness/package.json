{
  "name": "@aui/eval-harness",
  "version": "0.0.1",
  "private": true,
  "description": "Model quality evaluation harness for AUI Engine",
  "type": "module",
  "bin": {
    "aui-eval": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsup src/index.ts --format esm --clean",
    "eval": "node dist/index.js",
    "test": "vitest run",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@aui/schema": "workspace:*",
    "@aui/core": "workspace:*",
    "@aui/validator": "workspace:*",
    "@aui/policy": "workspace:*",
    "@aui/models": "workspace:*",
    "@aui/decision": "workspace:*",
    "@aui/components-landing": "workspace:*"
  },
  "devDependencies": {
    "rimraf": "^6.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
